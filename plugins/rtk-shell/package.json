{
  "name": "dsh-rtk-shell",
  "version": "0.1.0",
  "description": "RTK shell executor for DeepSeek Harness: transparently rewrites commands through `rtk rewrite` before execution while preserving sandbox and result semantics.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "executor.js",
    "rewrite-decision.js",
    "process-result.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0-0",
    "@deepseek-ai/dsh-bash-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.1-rc.2"
  },
  "keywords": [
    "dsh",
    "plugin",
    "rtk",
    "shell",
    "bundle"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
