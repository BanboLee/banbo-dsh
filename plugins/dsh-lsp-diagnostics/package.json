{
  "name": "dsh-lsp-diagnostics",
  "version": "0.1.0",
  "description": "Host-plane write-after LSP diagnostics for DeepSeek Harness: after an official write/edit/str_replace_editor mutation lands inside the session workspace, a single bounded aggregate diagnostics notice is appended to the tool result through the tools/post-execute waterfall.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "collector.js",
    "framing.js",
    "runtime.js",
    "render.js",
    "coordinator.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0-0",
    "@deepseek-ai/dsh-fs": ">=0.1.1-rc.2 <0.1.2-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.1.2-0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.1-rc.2 <0.1.2-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.1.2-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-str-replace-editor": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "keywords": [
    "dsh",
    "plugin",
    "lsp",
    "diagnostics"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
