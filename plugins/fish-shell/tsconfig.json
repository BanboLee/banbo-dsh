{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // Zero implicit any: every parameter of every checked file (the root `*.js`
    // sources and `tests/**/*.ts`) carries a real JSDoc/TS type, so this config
    // relies on NO relaxation — `noImplicitAny` is inherited from `strict`
    // above. New code must keep it that way; the check is
    // `pnpm exec tsc -p plugins/fish-shell/tsconfig.json --noEmit --noImplicitAny true`,
    // which must report nothing.
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["tests/**/*.ts", "*.js"]
}
