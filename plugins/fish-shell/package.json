{
  "name": "dsh-fish-shell",
  "version": "0.4.0",
  "description": "Fish shell executors and tool for DeepSeek Harness: run commands with fish instead of bash.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./local": "./local.js",
    "./tool": "./tool.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "local.js",
    "tool.js",
    "cordis.patch.yml",
    "presets/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0-0",
    "@deepseek-ai/dsh-bash-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2"
  },
  "keywords": [
    "dsh",
    "plugin",
    "fish",
    "shell",
    "bundle"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
