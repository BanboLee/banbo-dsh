{
  "name": "dsh-fish-shell",
  "version": "0.2.0",
  "description": "Fish shell executor and tool for DeepSeek Harness: run commands with fish instead of bash.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./tool": "./tool.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "tool.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "plugin",
    "fish",
    "shell",
    "bundle"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
