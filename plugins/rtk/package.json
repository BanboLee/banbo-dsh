{
  "name": "dsh-rtk",
  "version": "0.1.0",
  "description": "General-purpose RTK integration for DeepSeek Harness: a plain function plugin that decorates the mounted shell executor's `run`/`start` through `rtk rewrite` and compresses model-facing grep output through `rtk pipe`. Decorates the live `ctx.shell`, so it coexists with any shell provider (bash, fish, ...) without a duplicate service registration.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "grep-compress.js",
    "rewrite-decision.js",
    "process-result.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-bash-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.1-rc.2"
  },
  "keywords": [
    "dsh",
    "plugin",
    "rtk",
    "shell",
    "bundle"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
