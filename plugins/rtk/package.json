{
  "name": "@banbolee/dsh-rtk",
  "version": "0.3.2",
  "description": "General-purpose RTK integration for DeepSeek Harness: a plain function plugin that decorates the mounted shell executor's `execute` entry point through `rtk rewrite` and compresses model-facing grep output through `rtk pipe`. Decorates the live `ctx.shell`, so it coexists with any shell provider (bash, fish, ...) without a duplicate service registration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BanboLee/banbo-dsh.git",
    "directory": "plugins/rtk"
  },
  "homepage": "https://github.com/BanboLee/banbo-dsh/tree/main/plugins/rtk#readme",
  "bugs": {
    "url": "https://github.com/BanboLee/banbo-dsh/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "grep-compress.js",
    "rewrite-decision.js",
    "process-result.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-bash-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "plugin",
    "rtk",
    "shell",
    "bundle"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  }
}
