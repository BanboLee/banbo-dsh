      "@deepseek-ai/dsh-bash-sandbox": "0.1.5-rc.2",
      "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
      "@deepseek-ai/dsh-chunked-list": "0.1.5-rc.2",
