{
  "name": "banbo-dsh",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local DeepSeek Harness plugin bundles (rtk, codegraph-mcp) with a deterministic test harness.",
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "scripts": {
    "test": "vitest run",
    "test:harness": "vitest run tests/harness.spec.ts",
    "test:agents:gates": "vitest run --config vitest.gates.config.ts plugins/agents/tests/gates plugins/agents/tests/packed.spec.ts",
    "build:agents": "node plugins/agents/scripts/build.mjs",
    "test:e2e:headless": "RUN_REAL_HEADLESS_E2E=1 vitest run tests/e2e",
    "test:qa": "vitest run tests/qa",
    "qa:dsh-tui": "node scripts/qa/run-dsh-tui-upgrade.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "node-pty": "1.2.0-beta.15",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
      "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
      "@deepseek-ai/dsh-agent-loop-testkit": "0.1.5-rc.2",
